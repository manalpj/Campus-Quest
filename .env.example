# ------------------------------------------------------------------------------
# 1. Environment & Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: "development" or "production"
ENV=development

# Server port (Railway injects PORT automatically in production)
PORT=8000

# SQLite database path
# Local: data/quest.db (ensure directory exists)
# Railway (mounted volume): /data/quest.db
DB_PATH=data/quest.db

# Reverse proxy setting for Railway (ensures real client IP is detected for rate limits)
# Set to "*" on Railway, or leave empty/localhost for local development
FORWARDED_ALLOW_IPS=*

# Request body size limit in bytes (protection against denial-of-service)
MAX_BODY_BYTES=65536


# ------------------------------------------------------------------------------
# 2. Security & Admin Authentication
# ------------------------------------------------------------------------------
# Production requires custom values; server will fail to start if set to "change-me"
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-secure-passphrase

# 32-byte hexadecimal secret key used for signing session cookies
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-token

# Rate limiting windows
LOGIN_ATTEMPTS_PER_MIN=5
JOIN_ATTEMPTS_PER_MIN=10


# ------------------------------------------------------------------------------
# 3. Campus Coordinates & Bounds (Public via /api/config)
# ------------------------------------------------------------------------------
# Campus name displayed on headers
CAMPUS_NAME=DAVV Takshashila Campus

# Campus center (default view for map loading)
# Right-click center on Google Maps / OpenStreetMap to obtain coordinates
CAMPUS_CENTER_LAT=22.6928
CAMPUS_CENTER_LNG=75.8676

# Campus bounding box (South-West and North-East corners)
# Restricts map panning and validates checkpoint coordinates
CAMPUS_BOUNDS_SW_LAT=22.6850
CAMPUS_BOUNDS_SW_LNG=75.8580
CAMPUS_BOUNDS_NE_LAT=22.7010
CAMPUS_BOUNDS_NE_LNG=75.8780

# Zoom levels
CAMPUS_START_ZOOM=17
CAMPUS_MIN_ZOOM=15
CAMPUS_MAX_ZOOM=19


# ------------------------------------------------------------------------------
# 4. Map Tile Settings (Public via /api/config)
# ------------------------------------------------------------------------------
# OpenStreetMap tile template URL (no API key required)
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Tile attribution (must be visible on Leaflet map per OSM policy)
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors


# ------------------------------------------------------------------------------
# 5. Client Polling & Ping Intervals (Milliseconds)
# ------------------------------------------------------------------------------
# Frequency at which the player client posts GPS updates to /api/ping
PING_INTERVAL_MS=4000

# Frequency at which the player client polls /api/state for game updates
POLL_INTERVAL_MS=4000


# ------------------------------------------------------------------------------
# 6. Core Game Rules & Geofence Parameters
# ------------------------------------------------------------------------------
# Minimum number of checkpoints required before game start is allowed
MIN_CHECKPOINTS=5

# Minimum members required per team during registration
MIN_MEMBERS=2

# Global countdown in seconds before teams can start playing once game is started
COUNTDOWN_S=10

# GPS accuracy threshold in metres; fixes with accuracy worse than this are ignored
ACCURACY_LIMIT_M=30

# Number of consecutive inside-zone GPS fixes needed to unlock a checkpoint
STREAK_REQUIRED=2

# Speed plausibility threshold (metres per second); ~43 km/h
# Fixes exceeding this speed between server timestamps are flagged as implausible
MAX_SPEED_MPS=12.0


# ------------------------------------------------------------------------------
# 7. Power-up & Recovery Durations & Penalties (Seconds)
# ------------------------------------------------------------------------------
# Time added to team penalty when using a hint (3 minutes)
HINT_PENALTY_S=180

# Active duration of Radar power-up showing distance to checkpoint
RADAR_DURATION_S=60

# Active duration of Radius Boost power-up
BOOST_DURATION_S=120

# Percentage increase granted to checkpoint radius while Radius Boost is active (0.30 = +30%)
BOOST_PERCENT=0.30

# Time a team must remain stuck on a checkpoint before the Skip button appears (10 minutes)
SKIP_WAIT_S=600

# Time penalty added to team for skipping a checkpoint (10 minutes)
SKIP_PENALTY_S=600


# ------------------------------------------------------------------------------
# 8. Organizer Contact & Testing Controls
# ------------------------------------------------------------------------------
# Disclosed in /privacy, /terms, and emergency help footers
ORGANIZER_NAME=GDGoC DAVV Organizing Team
ORGANIZER_CONTACT=gdgoc@davv.ac.in

# Allow test mode (tap map to fake coordinates)
# MUST be false during live campus events!
ALLOW_TEST_MODE=false