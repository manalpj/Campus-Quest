#!/bin/sh
# Blocks committing .env and runs the tests before every commit.

if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "BLOCKED: .env is staged. Run: git restore --staged .env"
  exit 1
fi

if [ -d tests ]; then
  if python -m pytest --version >/dev/null 2>&1; then
    python -m pytest -q || { echo "BLOCKED: tests failed"; exit 1; }
  else
    echo "pytest not found, skipping tests"
  fi
fi